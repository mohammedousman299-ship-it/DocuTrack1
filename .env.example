# ==============================================================================
# DocuTrack — configuration d'exemple
# Aucun secret réel ne figure ici. Copier en .env et renseigner localement.
# ==============================================================================

APP_NAME=DocuTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ------------------------------------------------------------------------------
# Journalisation — contrainte de plateforme (§3.1)
# Le système de fichiers du conteneur n'est pas persistant : jamais de fichier.
# ------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Base de données — PostgreSQL
# En local : docker compose up. En production : Supabase (NON VALIDÉ, D-017).
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=docutrack
DB_USERNAME=docutrack
DB_PASSWORD=
# Pooler Supavisor en mode transaction : incompatible avec les prepared
# statements de PDO. À tester (OPEN_QUESTIONS.md Q-04). Passer à false si pooler.
DB_EMULATE_PREPARES=false

# ------------------------------------------------------------------------------
# Session, cache, file d'attente — contrainte de plateforme (§3.1)
# JAMAIS 'file' : le conteneur est éphémère et remis à zéro.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Stockage objet — contrainte de plateforme (§3.1, §3.3)
# JAMAIS 'local' : aucune image de document sur le disque du conteneur.
# En local : MinIO (compatible S3). Bucket privé, aucune URL publique.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=docutrack-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# ------------------------------------------------------------------------------
# Clés cryptographiques applicatives (D-007)
# Distinctes d'APP_KEY. Hors base de données, jamais dans le dépôt.
# La rotation de DOCUMENT_NUMBER_HMAC_KEY impose de recalculer tous les
# number_hmac : voir OPEN_QUESTIONS.md Q-26.
# ------------------------------------------------------------------------------
DOCUMENT_NUMBER_HMAC_KEY=

# ------------------------------------------------------------------------------
# Endpoints internes déclenchés par cron (§3.1)
# Protégés par secret d'en-tête. Générer une valeur aléatoire longue.
# ------------------------------------------------------------------------------
INTERNAL_CRON_SECRET=

# ------------------------------------------------------------------------------
# Adaptateurs externes — tous factices tant qu'aucun prestataire n'est confirmé
# ------------------------------------------------------------------------------
# Paiement : module désactivable (D-015). false => vérification donne N3 sans payer.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=fake
PAYMENT_AMOUNT_MINOR=100000
PAYMENT_CURRENCY=XAF

# SMS : contrôle anti-Sybil principal (D-013). Prestataire À CONFIRMER.
SMS_PROVIDER=fake
MAIL_MAILER=log

# ------------------------------------------------------------------------------
# Rapprochement — seuils de secours si matching_settings est vide
# Les valeurs de production vivent en base, modifiables sans redéploiement.
# ------------------------------------------------------------------------------
MATCHING_NOTIFY_THRESHOLD=0.75
MATCHING_REVIEW_THRESHOLD=0.55

VITE_APP_NAME="${APP_NAME}"
